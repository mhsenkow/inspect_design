{
  "name": "inspect-service",
  "version": "1.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --turbo",
    "type-check": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "e2e": "playwright test",
    "validate": "npm run type-check && npm run lint && npm run test && npm run e2e",
    "build-prod": "next build",
    "start-prod": "next start",
    "start:local": "IS_LOCAL_PRODUCTION=true next start",
    "deploy": "git stash && git pull && git stash pop && yarn cache clean && yarn install && yarn build && sudo pm2 flush && sudo pm2 restart 0",
    "db:create": "PGPASSWORD=${DATABASE_PASSWORD} psql -h ${DATABASE_HOST} -p ${DATABASE_PORT} -U ${DATABASE_USER} -c 'CREATE DATABASE inspect'",
    "db:migrate": "PGPASSWORD=${DATABASE_PASSWORD} psql -h ${DATABASE_HOST} -p ${DATABASE_PORT} -U ${DATABASE_USER} -d inspect < inspect-dump.sql",
    "db:reload": "PGPASSWORD=${DATABASE_PASSWORD} psql -h ${DATABASE_HOST} -p ${DATABASE_PORT} -U ${DATABASE_USER} -c 'DROP DATABASE IF EXISTS inspect' && PGPASSWORD=${DATABASE_PASSWORD} psql -h ${DATABASE_HOST} -p ${DATABASE_PORT} -U ${DATABASE_USER} -c 'CREATE DATABASE inspect' && PGPASSWORD=${DATABASE_PASSWORD} psql -h ${DATABASE_HOST} -p ${DATABASE_PORT} -U ${DATABASE_USER} -d inspect < inspect-dump.sql",
    "db:schema": "PGPASSWORD=${DATABASE_PASSWORD} psql -h ${DATABASE_HOST} -p ${DATABASE_PORT} -U ${DATABASE_USER} -d inspect < schema.sql",
    "export": "next export",
    "sqlite": "node src/scripts/sqlite-cli.js",
    "db:seed-sample": "node scripts/seed-sample-insights.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "@popperjs/core": "^2.11.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "bootstrap": "^5.3.3",
    "d3": "^7.9.0",
    "dotenv": "^17.2.0",
    "formidable": "^3.5.4",
    "global": "^4.4.0",
    "globals": "^16.3.0",
    "html-entities": "^2.6.0",
    "html-react-parser": "^5.1.15",
    "http-errors": "^2.0.0",
    "http-proxy-middleware": "^3.0.5",
    "knex": "^3.1.0",
    "moment": "^2.30.1",
    "nanoid": "^5.1.5",
    "next": "16.1.2",
    "next-client-cookies": "^2.0.0",
    "objection": "^3.1.5",
    "open-graph-scraper": "^6.8.1",
    "pg": "^8.16.3",
    "react": "19.2.3",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "19.2.3",
    "react-easy-edit": "^2.0.0",
    "reflect-metadata": "^0.2.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-modules-commonjs": "^7.26.3",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.26.0",
    "@next/eslint-plugin-next": "16.1.2",
    "@playwright/test": "^1.51.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bootstrap": "^5.2.10",
    "@types/d3": "^7.4.3",
    "@types/jest": "^30.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^24.0.14",
    "@types/pg": "^8.11.11",
    "@types/react": "19.2.8",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "babel-jest": "^30.0.4",
    "copy-webpack-plugin": "^13.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.11.0",
    "eslint-plugin-playwright": "^2.2.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.0.0",
    "prop-types": "^15.8.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "tsc": "^2.0.4",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.36.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "resolutions": {
    "@types/react": "19.2.8",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  }
}
